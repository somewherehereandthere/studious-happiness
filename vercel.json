{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/login", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*",   "destination": "/api/proxy" },
    { "source": "/app/:path*",   "destination": "/app.html" },
    { "source": "/admin/:path*", "destination": "/admin.html" }
  ]
}
